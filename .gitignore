build/
managed_components/
sdkconfig.old

# Node dependencies and frontend build output
node_modules/
dist/

# Linter/type-checker caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Editor/OS cruft
.DS_Store
.idea/
.vscode/

# Local environment overrides
.env
.env.*
